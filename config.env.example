# Copy this file to `config.env` and fill in the values below.
# `config.env` is gitignored — never commit real credentials.

# Your Claude organization UUID. Found in any claude.ai request URL,
# e.g. https://claude.ai/api/organizations/<ORG_ID>/usage
ORG_ID="00000000-0000-0000-0000-000000000000"

# Session cookies copied from a logged-in claude.ai browser session.
# See README.md → "Getting your credentials" for step-by-step instructions.
# These expire periodically — refresh them when the widget stops working.
SESSION_KEY="sk-ant-sid02-REPLACE_ME"
CF_CLEARANCE="REPLACE_ME"

# GUI widget mode (only affects claude_usage_widget.py, not the CLI):
#   "popup"   — on-demand window, closes on Esc or focus-out (default)
#   "desktop" — undecorated, pinned to bottom-left corner, autostart-friendly
#   "window"  — original floating window with decorations
WIDGET_MODE="popup"

# Auto-close the widget after N seconds (0 = disabled)
AUTO_CLOSE_SECONDS="4"
